{
  "name": "MocchiStream",
  "short_name": "MocchiStream",
  "description": "Películas y series en streaming, sin cuentas y sin complicaciones.",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "background_color": "#0f0f1a",
