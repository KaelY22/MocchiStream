  "lang": "es",
  "dir": "ltr",
  "categories": ["entertainment", "video"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Buscar",
      "short_name": "Buscar",
      "url": "/buscar.html",
      "icons": [{ "src": "/icons/shortcuts/search.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Favoritos",
      "short_name": "Favoritos",
      "url": "/favoritos.html",
      "icons": [{ "src": "/icons/shortcuts/heart.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Ver después",
      "short_name": "Ver después",
      "url": "/ver-despues.html",
      "icons": [{ "src": "/icons/shortcuts/clock.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Playlists",
      "short_name": "Playlists",
      "url": "/playlist.html",
      "icons": [{ "src": "/icons/shortcuts/list.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
}
